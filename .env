# codex-setup install-time variables
# This file is consumed by installer/codex_install.py for fresh installation.
# Keep strict shell syntax.

# Core install roots
CODEX_ROOT_DIR=/data/codex
CODEX_SYSTEM_DIR=/etc/codex
CODEX_USER_DIR=/data/codex/usr
CODEX_SHARE_DIR=/data/codex/share
CODEX_WRAPPER_DIR=/data/bin
CODEX_MCP_DIR=/data/codex/mcp
CODEX_BACKUP_DIR=/data/codex/backup

# Codex release package source (GitLab only)
CODEX_DOWNLOAD_URL=https://gitlab.com/api/v4/projects/80357241/packages/generic/codex
CODEX_DOWNLOAD_SHA=ce774b6d8a5331865f7446ba8b64020adfee87d3b96ad3a5c4c66de45b39b975
CODEX_DOWNLOAD_PKG=codex-rs-x86_64-unknown-linux-gnu-0.116.0-r22.tar.gz

# Source-build inputs for `make build-src` and `make build-install`
CODEX_SOURCE_REPO_URL=https://github.com/mjcramerz/codex.git
CODEX_SOURCE_BASE_REF=mcr/main
