{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env CODEX_HOOK_PLUGIN_BUNDLE=browser-automation perl ${CODEX_HOME}/.hooks/scripts/plugin_prompt_submit.pl",
            "timeout": 10,
            "statusMessage": "Injecting Browser Automation plugin context"
          }
        ]
      }
    ]
  }
}
