# GitLab -> GitHub delivery variable contract
# Use protected CI/CD variables for secrets.

# Shared include project for delivery jobs
GL_CICD_SHARED_PROJ=group/project-delivery
# Consumer include pattern: /github/validate.yml + /github/push.yml
# (shared includes provide /github/version.yml + /patches/patches.yml + /github/visibility.yml)
# Keep tracked mirrors (`github/mcr/main`, `github/mcr/staging`) read-only.

# Release version and deterministic bump script
GH_RELEASE_PUSH=true
APPEND_VERSION=true
RELEASE_VERSION=0.0.0
VERSION_BUMP_SCRIPT=scripts/release/bump_version.py
VERSION_BUMP_ARGS=--version

# Optional delivery behavior
# Protected `mcr/release` branch pipelines should only be created when GH_RELEASE_PUSH=true.
GH_FORCE_PUSH=true
GH_PUBLIC_REPO=
APPLY_PATCHES=true
APPLY_PATCHES_EXCLUDE=
# Default release overlay path + ordered series file.
# Shared patch helpers currently enforce these defaults; keep vars explicit for contract visibility.
PATCH_RELEASE_DIR=patches/release
PATCH_SERIES_FILE=patches/release/series
# Delivery mutation order is: checkout -> true sync -> version bump -> patch apply -> push.

# Optional GitLab Generic Package release-asset contract
GL_RELEASE_ASSET=false
GL_GROUP_TOP_RELEASE=
GL_PAT_RELEASE_TOKEN=
GL_CICD_RUNNER_BUILD=
GL_CICD_RUNNER_RELEASE=

# Required GitHub App/organization values (store as protected/masked vars)
GH_ORG_RELEASE=
GH_ORG_RELEASE_APP_ID=
GH_ORG_RELEASE_APP_PEM=
GH_ORG_RELEASE_APP_INSTALL_ID=
