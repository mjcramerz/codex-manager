# GitLab shared-include variable contract for delivery-oriented pipelines.
# Store secrets as protected CI/CD variables or through your managed secret system.

# Shared include project for delivery jobs.
# This value must already exist in the GitLab pipeline context because top-level includes
# are resolved before pipeline-local variables, tags, or job defaults are evaluated.
GL_CICD_SHARED_PROJ=group/project-delivery
# Common consumer include pattern:
#   /policy/jobs.yml
#   /policy/build.yml
#   /bws/common.yml
#   /policy/publish.yml
# Domain-specific layers such as /deploy/cf/.../common.yml or /ci/common.yml
# should remain thin. Shared publish selection now lives behind
# /policy/publish.yml and the matching /publish/*.yml entrypoints.

# Default runner-tag and image contract.
GLAB_RUNNER_TAG_HOST=
GLAB_RUNNER_TAG_TYPE=
GLAB_RUNNER_TAG_JOB=
GLAB_BUILD_IMAGE=
GLAB_PUBLISH_IMAGE=

# Optional repo-local command variables when the shared pipeline delegates behavior.
CI_VERIFY_COMMAND=
CI_TEST_COMMAND=
CI_BUILD_COMMAND=
CI_STAGE_COMMAND=

# Optional Bazel build variables for the shared /policy/build.yml entrypoint.
CI_BAZEL_BUILD_LABEL=
CI_BAZEL_BUILD_OUTPUT_BIN=
CI_BAZEL_BUILD_CONFIG_REMOTE=
CI_BAZEL_BUILD_CONFIG_LOCAL=

# Release version and deterministic bump script.
GH_RELEASE_PUSH=true
APPEND_VERSION=true
RELEASE_VERSION=0.0.0
VERSION_BUMP_SCRIPT=scripts/release/bump_version.py
VERSION_BUMP_ARGS=--version

# Delivery mutation order is: checkout -> true sync -> version bump -> patch apply -> push.
GH_FORCE_PUSH=true
GH_PUBLIC_REPO=
APPLY_PATCHES=true
APPLY_PATCHES_EXCLUDE=
PATCH_RELEASE_DIR=patches/release
PATCH_SERIES_FILE=patches/release/series

# Optional Rust release-build variables.
GL_RELEASE_CARGO_MANIFEST=Cargo.toml
GL_RELEASE_CARGO_EXCLUDES=
CARGO_TEST_FLAGS=
CARGO_BUILD_FLAGS=
CARGO_FMT_FLAGS=
CARGO_CLIPPY_FLAGS=
RUST_TOOLCHAIN=

# Optional Bazel and BuildBuddy variables.
BAZEL_STARTUP_FLAGS=
BAZEL_BUILD_FLAGS=
BAZEL_TEST_FLAGS=
BUILDBUDDY_ENDPOINT=
BUILDBUDDY_API_KEY=
BUILDBUDDY_INSTANCE=

# Optional GitLab Generic Package release-asset contract.
GL_RELEASE_ASSET=false
GL_GROUP_TOP_RELEASE=
GL_PAT_RELEASE_TOKEN=
GL_CICD_RUNNER_BUILD=
GL_CICD_RUNNER_RELEASE=

# Required GitHub App or organization values (store as protected/masked vars).
GH_ORG_RELEASE=
GH_ORG_RELEASE_APP_ID=
GH_ORG_RELEASE_APP_PEM=
GH_ORG_RELEASE_APP_INSTALL_ID=
