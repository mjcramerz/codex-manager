# GitHub Actions release-orchestration variable contract
# Use repository/environment variables for non-secret values and secrets for tokens.

# Shared workflow/action source
GH_ACTIONS_SHARED_PROJ=org/gh-actions-shared
GH_ACTIONS_SHARED_REF=main
GH_WORKFLOW_REF=main

# Release tag policy (example)
RELEASE_TAG_PREFIX=release-your-repo-v
RELEASE_BRANCH=mcr/release

# BWS integration variables (values usually supplied by secrets manager)
BWS_VERSION=
BWS_SHA256=
# Secret names (set via repo/environments):
# BWS_ACCESS_TOKEN
# BWS_PROJECT_ID
