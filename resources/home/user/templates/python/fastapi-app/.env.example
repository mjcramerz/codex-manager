# App settings (the FastAPI template reads APP_* env vars; see app/settings.py)
APP_ENVIRONMENT=dev
APP_ENABLE_HSTS=false
APP_MAX_BODY_BYTES=1048576

# Compose settings
APP_PORT=8000
LOG_FORMAT=json
APP_UID=
APP_GID=
DEV_UID=
DEV_GID=
ENGINE_UID=
ENGINE_GID=
# Tip: use `./rootless_env.sh --dotenv > .env`.

# Podman rootless: use compose.podman.override.yml (keep-id) for bind mounts.

# Optional proxy env vars (only if your environment requires it)
# HTTP_PROXY=http://proxy.example:3128
# HTTPS_PROXY=http://proxy.example:3128
# NO_PROXY=localhost,127.0.0.1
