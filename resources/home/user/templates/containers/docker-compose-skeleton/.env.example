APP_PORT=8080
LOG_FORMAT=json
APP_HOME=/app
APP_UID=
APP_GID=
DEV_UID=
DEV_GID=
ENGINE_UID=
ENGINE_GID=
# Tip: use `./rootless_env.sh --dotenv > .env`.
# Root override: use compose.rootful.override.yml when container root is required.
# Podman rootless: use compose.podman.override.yml (keep-id) for bind mounts.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
