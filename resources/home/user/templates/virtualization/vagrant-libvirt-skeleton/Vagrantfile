Vagrant.configure("2") do |config|
  config.vm.box = ENV.fetch("VAGRANT_BOX", "generic/debian12")
  if ENV["VAGRANT_BOX_VERSION"]
    config.vm.box_version = ENV["VAGRANT_BOX_VERSION"]
  end
  config.vm.hostname = "devbox"

  config.vm.provider :libvirt do |libvirt|
    libvirt.cpus = Integer(ENV.fetch("VAGRANT_CPUS", "2"))
    libvirt.memory = Integer(ENV.fetch("VAGRANT_MEM_MB", "2048"))
  end

  # Network templates:
  # - NAT is enabled by default.
  # - Private network for host↔VM dev traffic (adjust to taste).
  config.vm.network "private_network", type: "dhcp"
end
